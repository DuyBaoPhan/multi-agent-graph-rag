# ============================================================
# Highlands Coffee Multi-Agent Robot - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- SGLang ---
SGLANG_ROUTER_HOST=http://localhost:30000
SGLANG_GENERATOR_HOST=http://localhost:30001
SGLANG_ROUTER_MODEL=router-awq
SGLANG_GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=true

# --- LLM API (for data generation) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- TEI (Text Embeddings Inference) ---
TEI_HOST=http://localhost:8080
TEI_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Session ---
SESSION_TTL_MINUTES=30
SESSION_MAX_HISTORY=5
SESSION_CONTEXT_THRESHOLD=0.7

# --- Rate Limiting ---
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# --- Cache ---
SEMANTIC_CACHE_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
